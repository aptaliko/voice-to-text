# Login for the web page (HTTP Basic auth). Use a long random password.
APP_USERNAME=grafeio
APP_PASSWORD=change-me

# Whisper model. large-v3-turbo is the best speed/quality trade-off on CPU.
# Use "large-v3" for the best Greek accuracy (about 3x slower), or "medium" / "small" on a weak server.
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
# 0 = use all CPUs the container is allowed to use.
WHISPER_THREADS=0
WHISPER_LANGUAGE=el
# Optional: override the vocabulary hint (names of notaries, areas, standard phrases...).
# WHISPER_PROMPT=Συμβόλαιο αγοραπωλησίας ακινήτου. ...

OCR_LANGUAGES=ell+eng
MAX_UPLOAD_MB=200

# --- AI spelling correction (optional, off by default) ---
# Fixes words that sound the same but are spelled differently («η γνωστή» / «οι γνωστοί»).
# Only same-sounding word swaps are ever applied. Needs an Ollama server.
AI_CORRECTION=false
# Docker Ollama service (docker compose --profile ai up -d):
AI_URL=http://ollama:11434
# Native Ollama app on a Mac (faster, uses the GPU):
# AI_URL=http://host.docker.internal:11434
AI_MODEL=gemma3:12b
AI_TIMEOUT=300
# Optional: your own instructions instead of app/prompts/correction_el.md
# AI_PROMPT_FILE=/srv/app/prompts/correction_el.md
AI_CPUS=4
AI_MEMORY=12g

# Resource limits for the container (docker compose).
APP_CPUS=4
APP_MEMORY=6g
